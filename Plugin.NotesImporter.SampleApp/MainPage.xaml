<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plugin.NotesImporter.SampleApp.MainPage"
             Title="Notes Importer">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="Import notes" Style="{StaticResource Headline}" />
            <Label Text="Pick an exported notes folder (Google Takeout / Keep, Apple Notes HTML or NoteStore.sqlite, OneNote HTML). Source is auto-detected."
                   FontSize="13" TextColor="Gray" />
            <Picker x:Name="SourcePicker" Title="Source" SelectedIndex="0">
                <Picker.Items>
                    <x:String>Auto-detect</x:String>
                    <x:String>Google Keep</x:String>
                    <x:String>Apple Notes (HTML)</x:String>
                    <x:String>Apple Notes (database)</x:String>
                    <x:String>Microsoft OneNote</x:String>
                </Picker.Items>
            </Picker>
            <HorizontalStackLayout Spacing="8">
                <Button x:Name="PickButton" Text="Pick folder &amp; import" Clicked="OnPickClicked" />
                <Button x:Name="AppleDbButton" Text="Import this Mac's Apple Notes" Clicked="OnImportLocalAppleClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <Label Grid.Row="1" x:Name="StatusLabel" Text="No import yet." FontAttributes="Italic" />

        <CollectionView Grid.Row="2" x:Name="NotesView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#DDD" StrokeThickness="1" Padding="12" Margin="0,4"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Subtitle}" FontSize="12" TextColor="Gray" />
                            <Label Text="{Binding Snippet}" FontSize="14" />
                            <Image Source="{Binding FirstImage}" Aspect="AspectFit"
                                   HeightRequest="120" HorizontalOptions="Start"
                                   IsVisible="{Binding HasImage}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
